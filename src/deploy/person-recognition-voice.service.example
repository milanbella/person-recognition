[Unit]
Description=Person recognition shop voice test agent
After=network-online.target person-recognition-live.service
Wants=network-online.target

[Service]
Type=simple
User=ovie1
Group=ovie1
WorkingDirectory=/home/ovie1/person-recognition/src
LoadCredential=openai_api_key:/etc/person-recognition-live/openai-api-key
LoadCredential=operator_api_token:/etc/person-recognition-live/operator-token
ExecStart=/home/ovie1/person-recognition/src/.venv/bin/python /home/ovie1/person-recognition/src/shop_voice_agent.py --host 127.0.0.1 --port 8003 --operator-api-base-url http://127.0.0.1:8002 --operator-api-token-file ${CREDENTIALS_DIRECTORY}/operator_api_token --openai-api-key-file ${CREDENTIALS_DIRECTORY}/openai_api_key --state-db /home/ovie1/person-recognition/src/state/shop_state.sqlite
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
